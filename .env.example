# Copy to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL) ---------------------------------------------------
# Local: run `npx prisma dev --name bizbooks --detach` and paste the postgres:// URL it prints.
# Supabase: Project → Connect → ORMs. Use the "Transaction pooler" string (port 6543) here.
DATABASE_URL=""
# Supabase only: the "Session pooler" or direct string (port 5432). Used for migrations.
DIRECT_URL=""

# --- App -------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""
# Encrypts businesses' Paystack/Flutterwave secret keys. Must be 32 bytes, base64. NEVER change it
# after launch, or every saved gateway key becomes unreadable.
ENCRYPTION_KEY=""
# Your public address, e.g. https://bizbooks.ng. Optional on Vercel (it falls back to the Vercel domain).
SITE_URL=""

# --- Email (Resend) ----------------------------------------------------------
# Without these, emails are printed to the server log instead of sent.
RESEND_API_KEY=""
# A verified sender on your Resend domain, e.g. invoices@bizbooks.ng
EMAIL_FROM=""

# --- Daily job ---------------------------------------------------------------
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". Any long random string.
CRON_SECRET=""

# --- BizBooks Pro billing (your own Paystack account) ------------------------
# Used only to charge for the Pro plan. Customer invoice payments use each business's own keys.
# Webhook URL to set in your Paystack dashboard: https://<your-domain>/api/webhooks/platform
PLATFORM_PAYSTACK_SECRET_KEY=""

# --- Advisors ----------------------------------------------------------------
# Where "Book a free consultation" requests are emailed (they're also saved in the AdvisorRequest table).
ADVISORS_EMAIL=""

# --- Demo data (used by `npm run db:seed`) ------------------------------------
SEED_DEMO_PASSWORD=""

# Who can open /admin (the platform owner dashboard). Comma-separated sign-in emails.
ADMIN_EMAILS="hello@orbitagencyco.com"
